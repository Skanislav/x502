# Deployment / coordinator config — copy to .env and fill in.

# ---- Foundry deploy (contracts/script/Deploy.s.sol) ----
PRIVATE_KEY=0x...                      # deployer + repo owner
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=                      # optional, for `forge script --verify`
CHAINLINK_SUBSCRIPTION_ID=             # https://functions.chain.link/, fund with LINK
SECRETS_SLOT_ID=0                      # DON-hosted secrets slot
SECRETS_VERSION=                       # set after uploading the GH PAT via @chainlink/functions-toolkit
AUTHORIZER=                            # coordinator wallet allowed to call requestFact (defaults to deployer)
FUNCTIONS_SOURCE_PATH=../chainlink/source.js

# ---- Coordinator runtime ----
# The coordinator is a passive aggregator: it queues claims, waits for
# verifier-side skill helpers to push attestations, and submits the
# vault.payout once threshold is reached.
COORDINATOR_PORT=8787
VAULT_ADDRESS=0x...                    # from Deploy.s.sol output
FACT_PROVIDER_ADDRESS=0x...            # from Deploy.s.sol output
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e  # Base Sepolia USDC
COORDINATOR_REPO=owner/repo            # the slug this coordinator manages
COORDINATOR_THRESHOLD=2                # M of N
COORDINATOR_TRUSTED_AGENT_IDS=101,102,103  # comma-separated bigints
COORDINATOR_FACT_TIMEOUT_MS=120000
COORDINATOR_ATTESTATION_TIMEOUT_MS=300000  # 5 min — humans drive verifiers

# x402 anti-spam fee
X402_PAY_TO=0x...                      # typically same as the coordinator wallet
X402_PRICE=$0.01
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=                  # optional override; defaults to https://x402.org/facilitator

# ============================================================================
# 1claw — custody + secrets
# ============================================================================
# Both the coordinator's submitter wallet AND each verifier identity's
# signing key flow through 1claw. Two modes:
#
#   ONECLAW_MODE=local   reads keys from env (this file). Used by tests, CI,
#                        and the local demo.
#   ONECLAW_MODE=remote  calls the 1claw service. NOT YET WIRED — see
#                        packages/shared/src/oneclaw/client.ts. Setting this
#                        today fails fast with a clear error.
ONECLAW_MODE=local
ONECLAW_ENDPOINT=                      # remote mode only: 1claw service URL
ONECLAW_API_KEY=                       # remote mode only: 1claw auth token

# Coordinator wallet scope (the wallet that submits the payout tx).
COORDINATOR_ONECLAW_SCOPE_ID=COORDINATOR_PRIVATE_KEY
COORDINATOR_PRIVATE_KEY=0x...

# Per-verifier scopes. The x502-verify Claude skill loads these by env-var
# name when it signs an attestation. Convention: `VERIFIER_<agentId>_PRIVATE_KEY`.
VERIFIER_101_PRIVATE_KEY=0x...
VERIFIER_102_PRIVATE_KEY=0x...
VERIFIER_103_PRIVATE_KEY=0x...

# Optional smart-wallet wrap, per verifier. When set, the skill helper
# (`demo/scripts/x502.ts attest`) appends the EIP-6492 magic + factory call
# so the vault deploys VERIFIER_<id>_SMART_WALLET via _SMART_FACTORY on the
# first payout, then verifies via ERC-1271. The local demo's seed.ts writes
# these into addresses.json automatically when DEMO_SMART_WALLET=1.
VERIFIER_103_SMART_WALLET=
VERIFIER_103_SMART_FACTORY=
VERIFIER_103_SMART_CALLDATA=

# --- demo flags ---
# Set DEMO_SMART_WALLET=1 before `pnpm demo` to deploy MockSmartWalletFactory,
# turn verifier 103 into a counterfactual smart wallet, and exercise the
# vault's ERC-6492 deploy-then-verify path on the first claim.
# DEMO_SMART_WALLET=1

# Used by `demo/scripts/auto-fulfill.ts` (the local DON simulator) to fetch
# real GitHub issue/PR data when running the demo against real repos.
GITHUB_TOKEN=ghp_...

# ============================================================================
# How to invoke the verifier skill (developer reminder):
#   1. `pnpm demo`                                # boots anvil + coordinator
#   2. `source demo/scripts/skill-env.sh`         # exports VERIFIER_*_PRIVATE_KEY
#   3. `claude`                                   # opens Claude Code
#   4. `> /x502-verify as agent 101`              # invokes the skill
# Repeat (3-4) per verifier identity until threshold sigs land. The skill
# definition lives at `.claude/skills/x502-verify/SKILL.md`.
# ============================================================================
