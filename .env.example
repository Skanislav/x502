# Deployment / coordinator config — copy to .env and fill in.

# ---- Foundry deploy (contracts/script/Deploy.s.sol) ----
PRIVATE_KEY=0x...                      # deployer + repo owner
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=                      # optional, for `forge script --verify`
CHAINLINK_SUBSCRIPTION_ID=             # https://functions.chain.link/, fund with LINK
SECRETS_SLOT_ID=0                      # DON-hosted secrets slot
SECRETS_VERSION=                       # set after uploading the GH PAT via @chainlink/functions-toolkit
AUTHORIZER=                            # coordinator wallet allowed to call requestFact (defaults to deployer)
FUNCTIONS_SOURCE_PATH=../chainlink/source.js

# ---- Coordinator runtime ----
COORDINATOR_PORT=8787
VAULT_ADDRESS=0x...                    # from Deploy.s.sol output
FACT_PROVIDER_ADDRESS=0x...            # from Deploy.s.sol output
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e  # Base Sepolia USDC

# x402 anti-spam fee
X402_PAY_TO=0x...                      # typically same as the coordinator wallet
X402_PRICE=$0.01
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=                  # optional override; defaults to https://x402.org/facilitator

# ---- Verifier-agent runtime ----
VERIFIER_PORT=9000
VERIFIER_AGENT_ID=101                  # ERC-8004 token ID
VERIFIER_VAULT_ADDRESS=                # same as VAULT_ADDRESS above
VERIFIER_CHAIN_ID=84532                # Base Sepolia
VERIFIER_REPO_SLUG=skanislav/x502      # repo this agent signs claims for
RPC_URL=                               # optional override; viem default per chain otherwise

# ============================================================================
# 1claw — custody + secrets
# ============================================================================
# All wallets (verifier signers, coordinator submitter) and out-of-band
# secrets (ANTHROPIC_API_KEY, GITHUB_TOKEN) flow through 1claw. Two modes:
#
#   ONECLAW_MODE=local   reads keys + secrets from env (this file). Used by
#                        tests, CI, and the local demo.
#   ONECLAW_MODE=remote  calls the 1claw service. NOT YET WIRED — see
#                        packages/shared/src/oneclaw/client.ts. Setting this
#                        today fails fast with a clear error.
ONECLAW_MODE=local
ONECLAW_ENDPOINT=                      # remote mode only: 1claw service URL
ONECLAW_API_KEY=                       # remote mode only: 1claw auth token

# Per-component scope IDs. In local mode each scopeId is the env-var name
# below holding the raw private key. In remote mode it's whatever identifier
# the 1claw service uses to look up custody.
ONECLAW_SCOPE_ID=VERIFIER_PRIVATE_KEY              # verifier-agent wallet
COORDINATOR_ONECLAW_SCOPE_ID=COORDINATOR_PRIVATE_KEY  # coordinator submitter

# --- local-mode key bindings ---
VERIFIER_PRIVATE_KEY=0x...             # signer for EIP-712 attestations; must match getAgentWallet(agentId)
COORDINATOR_PRIVATE_KEY=0x...          # hot wallet that submits payout txs

# --- local-mode secrets ---
# Both the verifier-agent (ClaudePolicy) and the demo auto-fulfill watcher
# read these via OneClawClient.getSecret(name).
ANTHROPIC_API_KEY=sk-ant-...
GITHUB_TOKEN=ghp_...

# ============================================================================
# NOTE on remote + smart-account mode (future):
#   When OneClaw is wired in remote mode AND a verifier scope returns
#   kind="smart", the EIP-712 attestation signature it produces is ERC-1271
#   wrapped. The vault's current `ECDSA.recover` check rejects those. Switch
#   BountyVault to OZ `SignatureChecker.isValidSignatureNow` before turning
#   on smart-account verifier signers in production.
# ============================================================================
