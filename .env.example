# Deployment / coordinator config — copy to .env and fill in.

# ---- Foundry deploy (contracts/script/Deploy.s.sol) ----
PRIVATE_KEY=0x...                      # deployer + repo owner
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=                      # optional, for `forge script --verify`
CHAINLINK_SUBSCRIPTION_ID=             # https://functions.chain.link/, fund with LINK
SECRETS_SLOT_ID=0                      # DON-hosted secrets slot
SECRETS_VERSION=                       # set after uploading the GH PAT via @chainlink/functions-toolkit
AUTHORIZER=                            # coordinator wallet allowed to call requestFact (defaults to deployer)
FUNCTIONS_SOURCE_PATH=../chainlink/source.js

# ---- Coordinator runtime ----
COORDINATOR_PORT=8787
COORDINATOR_PRIVATE_KEY=0x...          # hot wallet that submits payout txs and pays verifier x402 calls
VAULT_ADDRESS=0x...                    # from Deploy.s.sol output
FACT_PROVIDER_ADDRESS=0x...            # from Deploy.s.sol output
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e  # Base Sepolia USDC

# x402 anti-spam fee
X402_PAY_TO=0x...                      # typically same as COORDINATOR_PRIVATE_KEY's address
X402_PRICE=$0.01
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=                  # optional override; defaults to https://x402.org/facilitator

# ---- Verifier-agent runtime ----
VERIFIER_PORT=9000
VERIFIER_AGENT_ID=101                  # ERC-8004 token ID
VERIFIER_VAULT_ADDRESS=                # same as VAULT_ADDRESS above
VERIFIER_CHAIN_ID=84532                # Base Sepolia
VERIFIER_NETWORK=base-sepolia          # CDP-known network (base | base-sepolia | ethereum-sepolia)
VERIFIER_REPO_SLUG=skanislav/x502      # repo this agent signs claims for
ANTHROPIC_API_KEY=sk-ant-...           # for ClaudePolicy
GITHUB_TOKEN=ghp_...                   # for Octokit
RPC_URL=                               # optional override; viem default per chain otherwise

# Wallet backend: "envkey" (default) or "cdp" (Coinbase AgentKit / CDP).
WALLET_PROVIDER=envkey

# --- envkey backend ---
VERIFIER_PRIVATE_KEY=0x...             # signer for EIP-712 attestations; must match getAgentWallet(agentId)

# --- cdp backend (Coinbase Developer Platform) ---
# Get keys at https://portal.cdp.coinbase.com — server-managed wallet, no
# private key on disk. Idempotent by name across restarts.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
VERIFIER_AGENT_NAME=                   # optional; defaults to "x502-verifier-${VERIFIER_AGENT_ID}"
CDP_WALLET_MODE=smart                  # "smart" (default, ERC-1271 Coinbase Smart Wallet) | "eoa"
CDP_REQUEST_FAUCET=false               # request testnet ETH on first boot

# NOTE on CDP_WALLET_MODE=smart:
#  Smart wallet must be DEPLOYED on chain before the first claim is settled.
#  The vault verifies via OZ SignatureChecker.isValidSignatureNow which calls
#  IERC1271(wallet).isValidSignature(digest, sig) — that returns false against
#  a no-code (counterfactual) address. Easiest deploy: have the wallet send
#  one userOp (e.g. tiny self-transfer) before adding it to vault.configureRepo.
