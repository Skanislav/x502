# Deployment / coordinator config — copy to `.env` and fill in.
#
# The demo runs end-to-end against LIVE Base Sepolia (chain 84532). There is
# no anvil/local mode any more. Every value below should point at real
# Base Sepolia infrastructure or a real signer with funds on Base Sepolia.
#
# See docs/runbook-base-sepolia.md for prerequisites:
#   - Base Sepolia ETH on each signing wallet (gas)
#   - Repo-owner wallet has Base Sepolia USDC for vault deposits
#   - Chainlink Functions subscription funded with LINK
#   - Trusted verifier wallet registered in ERC-8004 IdentityRegistry

# ---- Foundry deploy (contracts/script/Deploy.s.sol) ----
PRIVATE_KEY=0x...                      # deployer + repo owner (Base Sepolia)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=                      # optional, for `forge script --verify`
CHAINLINK_SUBSCRIPTION_ID=             # https://functions.chain.link/, fund with LINK
SECRETS_SLOT_ID=0                      # DON-hosted secrets slot
SECRETS_VERSION=                       # set after uploading the GH PAT via @chainlink/functions-toolkit
AUTHORIZER=                            # coordinator wallet allowed to call requestFact (defaults to deployer)
FUNCTIONS_SOURCE_PATH=../chainlink/source.js

# ---- Coordinator runtime ----
# The coordinator is a passive aggregator: it queues claims, watches EAS for
# trusted-verifier attestations under the x502 schema, and submits
# vault.payout once the configured threshold is reached.
COORDINATOR_PORT=8787
RPC_URL=https://sepolia.base.org      # must point at the same chain as the vault
VAULT_ADDRESS=0x951395a508ddF903e8F766960c93D94120F30877      # current EAS-flavor BountyVault, see docs/runbook-base-sepolia.md
FACT_PROVIDER_ADDRESS=0x8e4f147B51F1013aFa72B9b84EAB67893890edE6  # GitHubFactReceiver wired to Chainlink Functions
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e        # Circle USDC on Base Sepolia
COORDINATOR_REPO=skanislav/x502        # repo this coordinator manages
COORDINATOR_THRESHOLD=1                # M of N, 1 trusted attester for the demo
COORDINATOR_TRUSTED_AGENT_IDS=5260     # ERC-8004 IDs (comma-separated bigints)
COORDINATOR_FACT_TIMEOUT_MS=300000     # 5 min; Chainlink DON typically fulfills in 30–90s
COORDINATOR_ATTESTATION_TIMEOUT_MS=900000   # 15 min; humans drive verifiers

# x402 anti-spam fee
X402_PAY_TO=0x...                      # typically same address as the coordinator wallet
X402_PRICE=$0.01
X402_NETWORK=base-sepolia
X402_FACILITATOR_URL=                  # optional override; defaults to https://x402.org/facilitator

# ============================================================================
# 1claw — custody + secrets
# ============================================================================
# The coordinator's submitter wallet AND the verifier identity's signing key
# both flow through 1claw. Two modes:
#
#   ONECLAW_MODE=local   reads keys from env (this file). Used by tests, CI,
#                        and the demo.
#   ONECLAW_MODE=remote  calls the 1claw service. NOT YET WIRED — see
#                        packages/shared/src/oneclaw/client.ts. Setting this
#                        today fails fast with a clear error.
ONECLAW_MODE=local
ONECLAW_ENDPOINT=                      # remote mode only: 1claw service URL
ONECLAW_API_KEY=                       # remote mode only: 1claw auth token

# Coordinator wallet scope (the wallet that submits the payout tx).
COORDINATOR_ONECLAW_SCOPE_ID=COORDINATOR_PRIVATE_KEY
COORDINATOR_PRIVATE_KEY=0x...          # Base Sepolia ETH for gas

# ---- Verifier (single trusted attester) ----
# The Base Sepolia demo uses one trusted ERC-8004 verifier (agent 5260).
# `pnpm demo` builds `demo/scripts/skill-env.sh` from these values; sourcing
# that script makes `/x502-verify as agent 5260` work in a sibling Claude
# Code session. The skill helper (demo/scripts/x502.ts) reads the key by
# the env-var name, so the convention is `VERIFIER_PRIVATE_KEY` for the
# single-attester demo. Per-agent overrides use `VERIFIER_<id>_PRIVATE_KEY`.
VERIFIER_AGENT_ID=5260
VERIFIER_PRIVATE_KEY=0x...             # signs EAS attestations; must match
                                       # getAgentWallet(5260) on ERC-8004
VERIFIER_REPO_SLUG=skanislav/x502
VERIFIER_CHAIN_ID=84532
VERIFIER_NETWORK=base-sepolia
VERIFIER_VAULT_ADDRESS=0x951395a508ddF903e8F766960c93D94120F30877

# ---- External services ----
GITHUB_TOKEN=ghp_...                   # Octokit token used by the verifier
                                       # skill to fetch issue/PR state
ANTHROPIC_API_KEY=sk-ant-...           # for the ClaudePolicy rubric

# ---- Wallet backend (optional) ----
WALLET_PROVIDER=envkey                 # "envkey" (default) | "cdp"
# CDP backend (Coinbase Developer Platform). Leave blank for envkey mode.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
VERIFIER_AGENT_NAME=                   # defaults to "x502-verifier-${VERIFIER_AGENT_ID}"
CDP_WALLET_MODE=smart                  # "smart" (default) | "eoa"
CDP_REQUEST_FAUCET=false

# ============================================================================
# How to invoke the verifier skill (developer reminder):
#   1. `pnpm demo`                           # boots the live Base Sepolia stack
#   2. `source demo/scripts/skill-env.sh`    # exports VERIFIER_5260_PRIVATE_KEY + X502_*
#   3. `claude`                              # opens Claude Code
#   4. `> /x502-verify as agent 5260`        # invokes the skill against the live coordinator
# The skill definition lives at `.claude/skills/x502-verify/SKILL.md`.
# ============================================================================
